rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperUserEmail() {
      return isSignedIn() && request.auth.token.email == 'dev90946064@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isSuperUserEmail()
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow create, update, delete: if isValidId(productId) && isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );

      // Customer can create an order with initial PENDING or COD_PENDING payment status
      allow create: if isValidId(orderId) && (
        (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.userId == 'guest') ||
        isAdmin()
      ) && (
        request.resource.data.paymentStatus in ['PENDING', 'COD_PENDING'] ||
        isAdmin()
      );

      // Only administrators or backend can update orders (e.g. status transitions, shipment info, refund)
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Administrators
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && isAdmin();
      allow write: if isValidId(adminId) && isAdmin();
    }

    // Audit Logs - Append only
    match /audit_logs/{logId} {
      allow read: if isValidId(logId) && isAdmin();
      allow create: if isValidId(logId) && isAdmin();
      allow update, delete: if false;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId) && isAdmin();
    }
  }
}
