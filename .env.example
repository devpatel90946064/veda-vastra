# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY CREDENTIALS (ONLINE PAYMENTS & REFUNDS)
# ==============================================================================
# Obtain from Razorpay Dashboard: Settings -> API Keys (generate in Test Mode first)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourKeySecretHere"
# Set in Razorpay Dashboard: Settings -> Webhooks (point to ${APP_URL}/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ==============================================================================
# SHIPROCKET LOGISTICS & COURIER CREDENTIALS (ALL-INDIA SHIPPING)
# ==============================================================================
# Obtain from Shiprocket: Settings -> API -> API Users (email & password)
SHIPROCKET_EMAIL="your_shiprocket_email@example.com"
SHIPROCKET_PASSWORD="your_shiprocket_password"
# Pickup warehouse name as registered in Shiprocket panel (Settings -> Pickup Addresses)
SHIPROCKET_PICKUP_LOCATION="Primary Warehouse"
# Pickup warehouse PIN code (e.g., Delhi 110001, Mumbai 400001, Bangalore 560001)
SHIPROCKET_PICKUP_PINCODE="110001"
# Custom secret token to verify Shiprocket Tracking Webhooks at /api/webhooks/shiprocket
SHIPROCKET_WEBHOOK_TOKEN="your_shiprocket_webhook_secret_token"
